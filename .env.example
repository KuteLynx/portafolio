# Variables de entorno para desarrollo local
# Copia este archivo como .env y completa los valores
# ⚠️ .env está en .gitignore — no se sube al repo

# Cloudflare Turnstile — Site Key (pública, va en el frontend)
# Obténla en: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAA...

# URL del Worker de Cloudflare (backend del formulario)
# Se define al hacer wrangler deploy
# Para desarrollo local con wrangler dev: http://localhost:8787
VITE_CONTACT_API_URL=http://localhost:8787
