# Cloudflare Worker — Contact Form
# Configura estas variables como secrets en Cloudflare Dashboard:
#   wrangler secret put SENDGRID_API_KEY
#   wrangler secret put TURNSTILE_SECRET_KEY
#
# O直接用 variables en wrangler.toml (no recomendado para producción):
#   SENDGRID_API_KEY="SG.xxxxx"
#   TURNSTILE_SECRET_KEY="0x4AAAA..."
#   TO_EMAIL="tu@email.com"
#   FROM_EMAIL="tu@email.com"
#   FROM_NAME="Portafolio Contacto"
